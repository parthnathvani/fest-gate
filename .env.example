# Firebase project key used to exchange Google sign-in for a Firebase Authentication session.
FIREBASE_API_KEY=AIzaSyD2jMuX-HkqmIuqE_ADADvAfEMpOUIcpqw

# Copy this file to .env and enter an SMTP account to send real messages.
# Without these values the app records generated email in the local outbox only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM=Fest Gate <your-email@gmail.com>

# Optional secret required to create new Organizer accounts. Leave unset to disable Organizer signup.
# Set this to a long private code in your local .env file and share it only with trusted organizers.
# ORGANIZER_SIGNUP_CODE=choose-a-long-private-code
